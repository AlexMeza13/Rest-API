            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "get": {
                "summary": "Obtener detalle de un jugador",
                "tags": [
                    "Jugadores"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
