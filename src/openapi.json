            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Roster"
                }
              }
            }
          },
          "400": {
            "description": "El ID de ruta no es un entero positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El parametro \"id\" debe ser un entero positivo"
                }
              }
            }
          },
          "404": {
            "description": "No existe un roster con el ID indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Roster no encontrado"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "summary": "Actualizar un roster",
        "tags": [
          "Rosters"
        ],
        "requestBody": {
          "description": "Reemplaza nombre, tipo y temporada. Se requieren los tres campos; este endpoint no actualiza juego.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RosterUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Roster"
                }
              }
            }
          },
          "400": {
            "description": "El ID no es positivo, falta un campo obligatorio o tipo no es Principal ni Academy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El campo \"tipo\" debe ser uno de estos valores: Principal, Academy"
                }
              }
            }
          },
          "404": {
            "description": "No existe un roster con el ID indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Roster no encontrado"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "summary": "Eliminar un roster",
        "tags": [
          "Rosters"
        ],
        "responses": {
          "204": {
            "description": "Sin contenido"
          },
          "400": {
            "description": "El ID de ruta no es un entero positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El parametro \"id\" debe ser un entero positivo"
                }
              }
            }
          },
          "404": {
            "description": "No existe un roster con el ID indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Roster no encontrado"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rosters/{id}/jugadores": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador numerico entero positivo del roster. No admite cero, negativos ni texto.",
          "example": 1,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Listar jugadores de un roster",
        "tags": [
          "Asignaciones"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JugadorEnRoster"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El ID del roster no es un entero positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El parametro \"id\" debe ser un entero positivo"
                }
              }
            }
          },
          "404": {
            "description": "No existe un roster con el ID indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Roster no encontrado"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Asignar jugador a roster",
        "tags": [
          "Asignaciones"
        ],
        "requestBody": {
          "description": "El jugador debe existir y no estar ya asignado. id_jugador debe ser un entero positivo; rol_en_roster acepta Titular o Suplente.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RosterJugadorInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterJugador"
                }
              }
            }
          },
          "400": {
            "description": "El ID del roster o los datos enviados son invalidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El campo \"rol_en_roster\" debe ser uno de estos valores: Titular, Suplente"
                }
              }
            }
          },
          "404": {
            "description": "No existe el roster o jugador indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Jugador no encontrado"
                }
              }
            }
          },
          "409": {
            "description": "Se supero el maximo de cinco titulares o se asigno mas de un titular a la misma posicion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El roster ya alcanzo el maximo de 5 titulares"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/rosters/{id}/jugadores/{id_jugador}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador numerico entero positivo del roster. No admite cero, negativos ni texto.",
          "example": 1,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "id_jugador",
          "in": "path",
          "required": true,
          "description": "Identificador numerico entero positivo del jugador asignado. No admite cero, negativos ni texto.",
          "example": 1,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "put": {
        "summary": "Cambiar rol en roster",
        "tags": [
          "Asignaciones"
        ],
        "requestBody": {
          "description": "Actualiza el rol de la asignacion existente. rol_en_roster acepta unicamente Titular o Suplente.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RosterJugadorRoleInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterJugador"
                }
              }
            }
          },
          "400": {
            "description": "Algun ID de ruta no es positivo o rol_en_roster no es Titular ni Suplente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El campo \"rol_en_roster\" debe ser uno de estos valores: Titular, Suplente"
                }
              }
            }
          },
          "404": {
            "description": "No existe una asignacion para ese roster y jugador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Asignacion no encontrada"
                }
              }
            }
          },
          "409": {
            "description": "Se supero el maximo de cinco titulares o ya hay un titular en la misma posicion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Maximo 5 titulares"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "summary": "Quitar jugador del roster",
        "tags": [
          "Asignaciones"
        ],
        "responses": {
          "204": {
            "description": "Sin contenido"
          },
          "400": {
            "description": "Algun ID de ruta no es un entero positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "El parametro \"id_jugador\" debe ser un entero positivo"
                }
              }
            }
          },
          "404": {
            "description": "No existe una asignacion para ese roster y jugador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Asignacion no encontrada"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/roles": {
      "get": {
        "summary": "Listar roles validos",
        "tags": [
          "Auxiliares"
        ],
        "responses": {
          "200": {
            "description": "OK",
