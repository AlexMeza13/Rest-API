  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt_token"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "responses": {
      "InternalServerError": {
        "description": "Error interno inesperado al procesar la solicitud, por ejemplo, por un fallo en la base de datos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Error interno del servidor"
            }
          }
        }
      }
    },
    "schemas": {
      "Usuario": {
        "type": "object",
        "required": [
          "id",
          "email",
          "rol",
          "estado",
          "id_jugador",
          "jugador",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jugador@equipo.com"
          },
          "rol": {
            "type": "string",
            "enum": [
              "admin",
              "entrenador",
              "jugador"
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ]
          },
          "id_jugador": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "jugador": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "nickname": {
                "type": "string",
                "example": "Faker"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Jugador": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nickname": {
            "type": "string",
            "example": "Faker"
          },
          "nombre_real": {
            "type": "string",
            "example": "Lee Sang-hyeok"
          },
          "pais": {
            "type": "string",
            "example": "KR"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Top",
              "Jungle",
              "Mid",
              "ADC",
              "Support"
            ],
            "example": "Mid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ],
            "example": "activo"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JugadorInput": {
        "type": "object",
        "required": [
          "nickname",
          "nombre_real",
          "pais",
          "rol",
          "estado"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "example": "Faker"
          },
          "nombre_real": {
            "type": "string",
            "example": "Lee Sang-hyeok"
          },
          "pais": {
            "type": "string",
            "example": "KR"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Top",
              "Jungle",
              "Mid",
              "ADC",
              "Support"
            ],
            "example": "Mid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ],
            "example": "activo"
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "T1 Principal"
          },
          "juego": {
            "type": "string",
            "example": "League of Legends"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Principal",
              "Academy"
            ],
            "example": "Principal"
          },
          "temporada": {
            "type": "string",
            "example": "2026"
          },
          "id_entrenador": {
            "type": "integer",
            "nullable": true,
            "description": "ID de la cuenta que creo el roster; admin puede ver todos los propietarios.",
            "example": 10
          },
          "jugadores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JugadorEnRoster"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RosterInput": {
        "type": "object",
        "required": [
          "nombre",
          "tipo",
          "temporada"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "example": "T1 Principal"
          },
          "juego": {
            "type": "string",
            "default": "League of Legends",
            "example": "League of Legends"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Principal",
              "Academy"
            ],
            "example": "Principal"
          },
          "temporada": {
            "type": "string",
            "example": "2026"
          }
        }
      },
      "RosterUpdateInput": {
        "type": "object",
        "required": [
          "nombre",
          "tipo",
          "temporada"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "example": "T1 Principal"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Principal",
              "Academy"
            ],
            "example": "Principal"
          },
          "temporada": {
            "type": "string",
            "example": "2026"
          }
        }
      },
      "RosterJugador": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "id_roster": {
            "type": "integer",
            "example": 1
          },
          "id_jugador": {
            "type": "integer",
            "example": 1
          },
          "rol_en_roster": {
            "type": "string",
            "enum": [
              "Titular",
              "Suplente"
            ],
            "example": "Titular"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RosterJugadorInput": {
        "type": "object",
        "required": [
          "id_jugador",
          "rol_en_roster"
        ],
        "properties": {
          "id_jugador": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "rol_en_roster": {
            "$ref": "#/components/schemas/RosterJugador/properties/rol_en_roster"
          }
        }
      },
      "RosterJugadorRoleInput": {
        "type": "object",
        "required": [
          "rol_en_roster"
        ],
        "properties": {
          "rol_en_roster": {
            "$ref": "#/components/schemas/RosterJugador/properties/rol_en_roster"
          }
        }
      },
      "JugadorEnRoster": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nickname": {
            "type": "string",
            "example": "Faker"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Top",
              "Jungle",
              "Mid",
              "ADC",
              "Support"
            ],
            "example": "Mid"
          },
          "rol_en_roster": {
            "$ref": "#/components/schemas/RosterJugador/properties/rol_en_roster"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Formato de error devuelto por las validaciones, los servicios y el middleware global.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensaje que identifica el problema de la solicitud.",
            "example": "Datos de entrada invalidos"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "mensaje"
        ],
        "properties": {
          "mensaje": {
            "type": "string",
            "example": "API activa y funcionando"
          }
        }
      }
    }
  }
