                    "type": "string",
                    "enum": [
                      "Top",
                      "Jungle",
                      "Mid",
                      "ADC",
                      "Support"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/estados": {
      "get": {
        "summary": "Listar estados validos",
        "tags": [
          "Auxiliares"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "activo",
                      "inactivo"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tipos-roster": {
      "get": {
        "summary": "Listar tipos de roster",
        "tags": [
          "Auxiliares"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "Principal",
                      "Academy"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Verificar estado del API",
        "tags": [
          "Auxiliares"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "InternalServerError": {
        "description": "Error interno inesperado al procesar la solicitud, por ejemplo, por un fallo en la base de datos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Error interno del servidor"
            }
          }
        }
      }
    },
    "schemas": {
      "Jugador": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nickname": {
            "type": "string",
            "example": "Faker"
          },
          "nombre_real": {
            "type": "string",
            "example": "Lee Sang-hyeok"
          },
          "pais": {
            "type": "string",
            "example": "KR"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Top",
              "Jungle",
              "Mid",
              "ADC",
              "Support"
            ],
            "example": "Mid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ],
            "example": "activo"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JugadorInput": {
        "type": "object",
        "required": [
          "nickname",
          "nombre_real",
          "pais",
          "rol",
          "estado"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "example": "Faker"
          },
          "nombre_real": {
            "type": "string",
            "example": "Lee Sang-hyeok"
          },
          "pais": {
            "type": "string",
            "example": "KR"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Top",
              "Jungle",
              "Mid",
              "ADC",
              "Support"
            ],
            "example": "Mid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "inactivo"
            ],
            "example": "activo"
          }
        }
      },
      "Roster": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
